<?xml version="1.0" ?>
<!--
  ice_block_large — static ice sleeve for alpine RGB tests (severe icing).
  Visual mesh along local +X with icicles in -Z. Collision cylinder unchanged.
-->
<sdf version="1.8">
  <model name="ice_block_large">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://ice_block_large/meshes/ice_block_large.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.52 0.70 0.80 1</ambient>
          <diffuse>0.76 0.90 0.97 1</diffuse>
          <specular>0.58 0.64 0.70 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0 0 1.570796 0</pose>
        <geometry>
          <cylinder>
            <radius>0.45</radius>
            <length>1.80</length>
          </cylinder>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>0.4</mu>
              <mu2>0.4</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
