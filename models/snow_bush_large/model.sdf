<?xml version="1.0" ?>
<!--
  snow_bush_large — soft obstacle for snow_forest.
  Origin at ground contact, centred XY.
  The window draws the bush OBJ. Collision is a cylinder sized to the mesh
  AABB (~1.4 m). lidar_body repeats that cylinder on visibility bit
  0x10000000 only, which the Fortress user camera does not draw.
-->
<sdf version="1.8">
  <model name="snow_bush_large">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://snow_bush_large/meshes/snow_bush_large.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Lidar proxy: same pose/size as collision. Not drawn by the GUI camera. -->
      <visual name="lidar_body">
        <pose>0 0 0.72 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>268435456</visibility_flags>
        <geometry>
          <cylinder>
            <radius>0.68</radius>
            <length>1.44</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.32 0.16 1</ambient>
          <diffuse>0.28 0.40 0.20 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.72 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.68</radius>
            <length>1.44</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
