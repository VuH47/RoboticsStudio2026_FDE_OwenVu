<?xml version="1.0" ?>
<!--
  snow_bush_small — soft obstacle for snow_forest.
  Origin at ground contact, centred XY.
  Same split as snow_bush_large: bush OBJ for the window, cylinder collision,
  lidar_body on visibility bit 0x10000000 only.
-->
<sdf version="1.8">
  <model name="snow_bush_small">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://snow_bush_small/meshes/snow_bush_small.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <!-- Collision stays 0.80 m tall. This proxy reaches past the scan plane. -->
      <visual name="lidar_body">
        <pose>0 0 0.70 0 0 0</pose>
        <cast_shadows>false</cast_shadows>
        <visibility_flags>268435456</visibility_flags>
        <geometry>
          <cylinder>
            <radius>0.40</radius>
            <length>1.40</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.20 0.32 0.16 1</ambient>
          <diffuse>0.28 0.40 0.20 1</diffuse>
          <specular>0.02 0.02 0.02 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <pose>0 0 0.40 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.40</radius>
            <length>0.80</length>
          </cylinder>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
