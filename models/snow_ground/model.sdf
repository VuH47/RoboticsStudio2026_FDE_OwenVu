<?xml version="1.0"?>
<sdf version="1.8">
  <model name="snow_ground">
    <static>true</static>
    <!-- Trimmed world: X ≈ -30..+90 (was -30..+210). Width Y ±55 unchanged. -->
    <link name="ground">
      <collision name="ground_collision">
        <pose>30 0 0.01 0 0 0</pose>
        <geometry>
          <box>
            <size>120 110 0.02</size>
          </box>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name="snow_visual">
        <cast_shadows>false</cast_shadows>
        <pose>30 0 0 0 0 0</pose>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>120 110</size>
          </plane>
        </geometry>
        <material>
          <ambient>0.9 0.92 0.95 1</ambient>
          <diffuse>0.95 0.97 1.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
