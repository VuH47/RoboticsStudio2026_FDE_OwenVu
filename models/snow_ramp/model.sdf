<?xml version="1.0" ?>
<sdf version="1.8">
  <model name="snow_ramp">
    <pose>0 0 0 0 0 0</pose>
    <static>true</static>
    <link name="body">
      <!-- Triangular-prism wedge (OBJ), trimmed to ~RR4:
           - Length 60 m, width 110 m, pitch ~0.07 rad (~4°)
           - Entry flush at z=0; summit H = 60 * tan(0.07) ≈ 4.21 m
           - World include pose (20 0 0) → entry x=20, summit x≈80 -->
      <visual name="visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://snow_ramp/meshes/snow_ramp.obj</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0.9 0.92 0.95 1</ambient>
          <diffuse>0.95 0.97 1.0 1</diffuse>
          <specular>0.15 0.15 0.15 1</specular>
        </material>
      </visual>

      <collision name="collision">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <!-- Closed wedge (floor z=0.05): blocks tunneling under the slope. -->
            <uri>model://snow_ramp/meshes/snow_ramp_collision.obj</uri>
          </mesh>
        </geometry>
        <surface>
          <friction>
            <ode>
              <mu>1.0</mu>
              <mu2>1.0</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
    </link>
  </model>
</sdf>
