<?xml version="1.0" ?>
<!--
  snow_rock_large — soft obstacle for snow_forest.
  Origin at ground contact, centred XY. Collision is a cheap box.
-->
<sdf version="1.8">
  <model name="snow_rock_large">
    <static>true</static>
    <link name="link">
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <mesh>
            <uri>model://snow_rock_large/meshes/snow_rock_large.obj</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name="collision">
        <pose>0 0 0.8 0 0 0</pose>
        <geometry>
          <box>
            <size>2.4 2.4 1.6</size>
          </box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>
