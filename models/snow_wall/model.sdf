<?xml version="1.0"?>
<sdf version="1.8">
  <model name="snow_wall">
    <static>true</static>
    <link name="link">
      <!-- Thin box. Link Z is the thickness; the world pose rolls the panel upright. -->
      <collision name="collision">
        <geometry>
          <box>
            <size>10 8 0.05</size>
          </box>
        </geometry>
      </collision>
      <visual name="visual">
        <cast_shadows>false</cast_shadows>
        <geometry>
          <plane>
            <normal>0 0 1</normal>
            <size>10 8</size>
          </plane>
        </geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0.05 0.05 0.05 1</specular>
          <double_sided>true</double_sided>
          <pbr>
            <metal>
              <albedo_map>model://snow_wall/materials/textures/snow_wall.jpg</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
