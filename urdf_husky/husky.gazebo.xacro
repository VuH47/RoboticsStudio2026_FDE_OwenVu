<?xml version="1.0"?>
<robot name="husky" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="laser_visual"  default="false" />
  <xacro:arg name="camera_visual" default="false"/>
  <xacro:arg name="imu_visual"    default="false"/>
  <xacro:arg name="gz_model_name" default="husky"/>
  <xacro:property name="gz_model_name" value="$(arg gz_model_name)"/>

  <xacro:include filename="$(find 41068_ignition_bringup)/urdf_husky/wheel.urdf.xacro"/>

  <gazebo reference="${prefix}imu_link">
    <sensor type="imu" name="imu">
      <always_on>true</always_on>
      <visualize>$(arg imu_visual)</visualize>
      <update_rate>100</update_rate>
      <topic>model/${gz_model_name}/imu</topic>
      <gz_frame_id>${prefix}imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
      <plugin
        filename="ignition-gazebo-imu-system"
        name="ignition::gazebo::systems::Imu">
      </plugin>
    </sensor>
    <material>Gazebo/Grey</material>
  </gazebo>
 
  <!-- Move base directly without faffing around with diff drive controllers -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-velocity-control-system"
      name="ignition::gazebo::systems::VelocityControl">
      <topic>model/${gz_model_name}/cmd_vel</topic>
    </plugin>
  </gazebo>

  <!-- Publish odometry separately -->
  <gazebo>
    <plugin
      filename="ignition-gazebo-odometry-publisher-system"
      name="ignition::gazebo::systems::OdometryPublisher">
      <topic>model/${gz_model_name}/odometry</topic>
      <odom_publish_frequency>20</odom_publish_frequency>
      <odom_frame>${prefix}odom</odom_frame>
      <robot_base_frame>${prefix}base_link</robot_base_frame>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <gazebo>
    <plugin
      filename="ignition-gazebo-joint-state-publisher-system"
      name="ignition::gazebo::systems::JointStatePublisher">
      <topic>model/${gz_model_name}/joint_states</topic>
    </plugin>
  </gazebo>

  <gazebo reference="${prefix}base_scan">
    <material>Gazebo/FlatBlack</material>
    <sensor type="gpu_lidar" name="lidar">
      <pose relative_to='${prefix}base_scan'>0 0 0 0 0 0</pose>
      <visualize>$(arg laser_visual)</visualize>
      <topic>model/${gz_model_name}/scan</topic>
      <!-- Include bit 0x10000000 (lidar proxies hidden from the GUI camera). -->
      <visibility_mask>4294967295</visibility_mask>
      <update_rate>3</update_rate>
      <gz_frame_id>${prefix}base_scan</gz_frame_id>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>0.0</min_angle>
            <max_angle>6.28319</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.2</min>
          <max>40</max>
          <resolution>0.015</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!-- Wheels hit a rock before the base box does. Each wheel publishes
       its own contact. Ground contacts are ignored by husky_bumper_stop. -->
  <xacro:macro name="wheel_contact_sensor" params="wheel_id">
    <gazebo reference="${prefix}${wheel_id}_wheel_link">
      <sensor name="${wheel_id}_contact" type="contact">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <topic>model/${gz_model_name}/${wheel_id}_contact</topic>
        <contact>
          <collision>wheel_collision</collision>
        </contact>
      </sensor>
    </gazebo>
  </xacro:macro>
  <xacro:wheel_contact_sensor wheel_id="front_left"/>
  <xacro:wheel_contact_sensor wheel_id="front_right"/>
  <xacro:wheel_contact_sensor wheel_id="rear_left"/>
  <xacro:wheel_contact_sensor wheel_id="rear_right"/>

  <!-- Base contact. Nav2 has no bumper; this is the stop signal when the
       collision body is already touching and the scan has not marked it. -->
  <gazebo reference="${prefix}base_link">
    <sensor name="bumper_contact" type="contact">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <topic>model/${gz_model_name}/bumper_contact</topic>
      <contact>
        <collision>base_link_collision</collision>
        <collision>base_link_collision_bottom</collision>
        <collision>base_link_collision_1</collision>
      </contact>
    </sensor>
  </gazebo>

  <!-- Second gpu_lidar is expensive on WSL software GL. Only spawn it when
       terrain:=true (optional elevation map). Climbing uses scan_filtered. -->
  <xacro:if value="$(arg enable_sonar)">
    <gazebo reference="${prefix}sonar_link">
      <material>Gazebo/Grey</material>
      <sensor type="gpu_lidar" name="sonar">
        <pose relative_to='${prefix}sonar_link'>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <topic>model/${gz_model_name}/sonar</topic>
        <update_rate>5</update_rate>
        <gz_frame_id>${prefix}sonar_link</gz_frame_id>
        <ray>
          <scan>
            <horizontal>
              <samples>20</samples>
              <resolution>1</resolution>
              <min_angle>-0.0872665</min_angle>
              <max_angle>0.0872665</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.2</min>
            <max>15</max>
            <resolution>0.015</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </ray>
        <always_on>true</always_on>
      </sensor>
    </gazebo>
  </xacro:if>

  <gazebo reference="${prefix}camera_link">
    <sensor name="rgbd_camera" type="rgbd_camera">
      <camera>
        <!-- 75 deg FOV. 320x240 keeps WSL/software-GL RGBD cost down; confirm
             still works (Issue 52). Raise only if evidence crops are too soft. -->
        <horizontal_fov>1.309</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
        </image>
        <clip>
          <near>0.1</near>
          <far>40</far>
        </clip>
        <!-- depth_camera near/far clip seems to be ignored for some reason -->
        <!--    We're using Ignition Gazebo Fortress, which uses sdf format 1.9: http://sdformat.org/tutorials?tut=roadmap -->
        <!--    This takes the depth_camera parameter with near / far clip http://sdformat.org/spec?ver=1.4&elem=sensor  -->
        <!-- We also use ign sensors v6 ( run ls | grep libignition-sensors in /usr/lib/x86_64-linux-gnu)-->
        <!-- Looking at the source code, the sdf sets HasDepthCamera() and corresponding HasDepthNearClip() & HasDepthFarClip() which are used in RgbdCameraSensor.cc, so this should work? -->
        <!--    SDF description of Camera: https://github.com/gazebosim/sdformat/blob/sdf9/src/Camera.cc#L598-->
        <!--    Camera sensor source code: https://github.com/gazebosim/gz-sensors/blob/ign-sensors6/src/RgbdCameraSensor.cc#L311  -->
        <depth_camera>
          <clip>
            <near>0.4</near>
            <far>10</far>
          </clip>
        </depth_camera>
      </camera>
      <always_on>1</always_on>
      <update_rate>2</update_rate>
      <visualize>$(arg camera_visual)</visualize>
      <topic>/model/${gz_model_name}/camera</topic>
      <gz_frame_id>${prefix}camera_link</gz_frame_id>
    </sensor>
  </gazebo>

</robot>
